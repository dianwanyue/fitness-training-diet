FD9D2', padding:'0 6px' }}><Text style={{ fontSize: 18, color: '#14563F', fontWeight: 'bold', lineHeight: 1.3, width: 190 }}>F 统计 · 3</Text><Text style={{ fontSize: 16, color: '#1C2A24', lineHeight: 1.4 }}>完成率、摄入趋势、体重趋势　|　1001 / 1002</Text></Box><Box style={{ height:57, flexDirection:'row', gap:20, alignItems:'center', borderBottom:'1px solid #CFD9D2', padding:'0 6px' }}><Text style={{ fontSize: 18, color: '#14563F', fontWeight: 'bold', lineHeight: 1.3, width: 190 }}>G AI 分析 · 7</Text><Text style={{ fontSize: 16, color: '#1C2A24', lineHeight: 1.4 }}>授权、生成、历史、详情、删除　|　登录 + 授权，5001 / 5003</Text></Box><Box style={{ height:57, flexDirection:'row', gap:20, alignItems:'center', padding:'0 6px' }}><Text style={{ fontSize: 18, color: '#14563F', fontWeight: 'bold', lineHeight: 1.3, width: 190 }}>H 后台管理 · 5</Text><Text style={{ fontSize: 16, color: '#1C2A24', lineHeight: 1.4 }}>动作 / 食物维护、账户状态　|　ADMIN 鉴权，1003 / 1005</Text></Box></Box></Box>
